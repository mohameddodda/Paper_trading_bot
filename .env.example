# ========================================
# Paper Trading Bot – API Key Template
# ========================================

# WARNING: This file is for PAPER TRADING SIMULATIONS ONLY.
# NEVER use this bot for real financial transactions, live trading, or any illegal activities.
# API keys are for educational purposes (e.g., fetching data or AI signals).
# Keep this file secure—do not share real keys publicly.

# Get your FREE key at: https://openrouter.ai/keys
# (Includes $5 credit -- no card needed)
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Yahoo Finance API key (if needed for advanced stock data)
YAHOO_API_KEY=your_yahoo_key_here

# Optional: Customize starting balance (matches config.py STARTING_CASH)
STARTING_BALANCE=1000000

# Optional: For cloud deployment (AWS ECS – leave blank if not using)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Optional: For real-time streaming (Polygon.io API key – free tier available)
POLYGON_API_KEY=your_polygon_key_here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholders with your actual keys (get from respective sites).
# 3. Do NOT commit .env to Git—it's in .gitignore for security.
# 4. If a key is missing, features may disable gracefully (e.g., AI off without OPENROUTER_API_KEY).