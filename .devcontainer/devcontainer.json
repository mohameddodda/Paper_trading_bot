{
  "name": "Paper Trading Bot Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "bot",
  "workspaceFolder": "/app",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/pre-commit:2.0.1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.mypy-type-checker",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "GitHub.copilot",
        "ms-vscode.test-adapter-converter",
        "ms-vscode.pylint"
      ]
    }
  },
  "forwardPorts": [8501, 5432, 6379],
  "postCreateCommand": "pip install -r requirements.txt -e . && pre-commit install"
}
