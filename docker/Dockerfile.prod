FROM python:3.12-slim as builder

WORKDIR /app

# Copy requirements for deps layer
COPY requirements.txt setup.py pyproject.toml* ./

# Install deps into wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --no-deps --find-links /wheels -r requirements.txt -w /wheels && \
    pip wheel --no-cache-dir -e . -w /wheels

FROM python:3.12-slim as runtime

WORKDIR /app

# Prod runtime deps (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install deps from wheels
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --force-reinstall /wheels/* && rm -rf /wheels

# Copy application code (minimal for prod)
COPY config/ config/
COPY core/ core/
COPY bots/ bots/
# training/ if models used at runtime, else mount

# Non-root user for security
RUN groupadd --system appuser && useradd --system --create-home --no-log-init --gid appuser appuser && \
    mkdir -p /app/checkpoints /home/appuser && \
    chown -R appuser:appuser /app /home/appuser

USER appuser

VOLUME ["/app/paper_trading.db", "/app/checkpoints"]

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import core; print('core healthy') || exit 1" || exit 1

ENTRYPOINT ["python", "-m", "bots.multi_bot_orchestrator"]
CMD ["--help"]

